@model CourseRegistration.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-lg auth-card">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="auth-icon mb-3">
                        <i class="bi bi-box-arrow-in-right display-4 text-primary"></i>
                    </div>
                    <h3 class="fw-bold">Đăng nhập</h3>
                    <p class="text-muted">Nhập tài khoản để vào hệ thống</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold">
                            <i class="bi bi-person me-1"></i>Tên đăng nhập
                        </label>
                        <input asp-for="Username" class="form-control form-control-lg" placeholder="Nhập tên đăng nhập" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">
                            <i class="bi bi-lock me-1"></i>Mật khẩu
                        </label>
                        <input asp-for="Password" class="form-control form-control-lg" placeholder="Nhập mật khẩu" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                    </button>
                </form>

                <div class="divider my-4">
                    <span class="divider-text text-muted">hoặc</span>
                </div>

                <a asp-controller="Account" asp-action="GoogleLogin" class="btn btn-outline-dark btn-lg w-100 mb-3">
                    <i class="bi bi-google me-1"></i>Đăng nhập bằng Google
                </a>

                <div class="text-center mt-3">
                    <span class="text-muted">Chưa có tài khoản?</span>
                    <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold text-decoration-none ms-1">Đăng ký ngay</a>
                </div>

                <div class="mt-3 p-3 bg-light rounded">
                    <p class="small text-muted mb-1"><strong>Tài khoản demo:</strong></p>
                    <p class="small text-muted mb-0">Admin: <code>admin</code> / <code>Admin@123</code></p>
                    <p class="small text-muted mb-0">Student: <code>student</code> / <code>Student@123</code></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
