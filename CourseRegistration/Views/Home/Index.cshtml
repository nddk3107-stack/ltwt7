@model CourseRegistration.Models.CourseListViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Section -->
<div class="hero-section text-center mb-5">
    <h1 class="display-5 fw-bold text-gradient">
        <i class="bi bi-mortarboard-fill"></i> Danh sách học phần
    </h1>
    <p class="lead text-muted">Khám phá và đăng ký các học phần phù hợp với bạn</p>
</div>

<!-- Câu 8: Search Bar -->
<div class="row justify-content-center mb-4">
    <div class="col-md-8 col-lg-6">
        <form method="get" asp-action="Index" class="position-relative">
            <div class="input-group input-group-lg shadow-sm search-box">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchQuery" 
                       class="form-control border-start-0 ps-0" 
                       placeholder="Tìm kiếm học phần..." 
                       id="searchInput" />
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
                <button class="btn btn-primary px-4" type="submit">
                    <i class="bi bi-search me-1"></i>Tìm kiếm
                </button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SearchQuery))
{
    <div class="text-center mb-3">
        <span class="badge bg-info-subtle text-info-emphasis fs-6 px-3 py-2">
            <i class="bi bi-funnel me-1"></i>
            Kết quả tìm kiếm cho "<strong>@Model.SearchQuery</strong>"
            — @Model.Courses.Count kết quả
        </span>
    </div>
}

<!-- Course Grid -->
@if (Model.Courses.Any())
{
    <div class="row g-4">
        @foreach (var course in Model.Courses)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card course-card h-100 border-0 shadow-sm">
                    <div class="course-image-wrapper">
                        @if (!string.IsNullOrEmpty(course.Image))
                        {
                            <img src="@course.Image" class="card-img-top course-image" alt="@course.Name"
                                 loading="lazy" onerror="this.onerror=null;this.src='/images/placeholder.svg'" />
                        }
                        else
                        {
                            <div class="course-placeholder d-flex align-items-center justify-content-center">
                                <i class="bi bi-book display-1 text-white opacity-50"></i>
                            </div>
                        }
                        <div class="course-badge">
                            <span class="badge bg-primary rounded-pill">
                                <i class="bi bi-star-fill me-1"></i>@course.Credits tín chỉ
                            </span>
                        </div>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-light text-dark mb-2 align-self-start">
                            <i class="bi bi-tag me-1"></i>@course.Category?.Name
                        </span>
                        <h5 class="card-title fw-bold">@course.Name</h5>
                        <p class="card-text text-muted mb-3">
                            <i class="bi bi-person-badge me-1"></i>@course.Lecturer
                        </p>
                        <div class="mt-auto">
                            @if (Model.IsStudent)
                            {
                                @if (Model.EnrolledCourseIds.Contains(course.Id))
                                {
                                    <form asp-controller="Enrollment" asp-action="Unenroll" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100"
                                                onclick="return confirm('Bạn có chắc muốn hủy đăng ký?')">
                                            <i class="bi bi-x-circle me-1"></i>Hủy đăng ký
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Enrollment" asp-action="Enroll" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100">
                                            <i class="bi bi-plus-circle me-1"></i>Đăng ký
                                        </button>
                                    </form>
                                }
                            }
                            else if (!Model.IsAuthenticated)
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm w-100">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập để đăng ký
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Câu 1: Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-5 d-flex justify-content-center" aria-label="Pagination">
            <ul class="pagination pagination-lg shadow-sm">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" 
                       href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.SearchQuery })">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" 
                           href="@Url.Action("Index", new { page = i, search = Model.SearchQuery })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" 
                       href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.SearchQuery })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <p class="lead text-muted mt-3">Không tìm thấy học phần nào.</p>
        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>Xem tất cả học phần
            </a>
        }
    </div>
}
