@model IEnumerable<CourseRegistration.Models.Enrollment>
@{
    ViewData["Title"] = "Học phần của tôi";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-journal-bookmark-fill text-primary me-2"></i>Học phần của tôi
        </h2>
        <p class="text-muted mb-0">Danh sách các học phần bạn đã đăng ký</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Đăng ký thêm
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-journal-x display-1 text-muted"></i>
        <h4 class="mt-3">Bạn chưa đăng ký học phần nào</h4>
        <p class="text-muted">Hãy quay lại danh sách học phần để chọn môn phù hợp.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-search me-1"></i>Xem danh sách học phần
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var enrollment in Model)
        {
            var course = enrollment.Course;
            if (course == null)
            {
                continue;
            }

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card course-card h-100 border-0 shadow-sm">
                    <div class="course-image-wrapper">
                        @if (!string.IsNullOrEmpty(course.Image))
                        {
                            <img src="@course.Image"
                                 class="card-img-top course-image"
                                 alt="@course.Name"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/placeholder.svg'" />
                        }
                        else
                        {
                            <div class="course-placeholder d-flex align-items-center justify-content-center">
                                <i class="bi bi-book display-1 text-white opacity-50"></i>
                            </div>
                        }
                        <div class="course-badge">
                            <span class="badge bg-primary rounded-pill">
                                <i class="bi bi-star-fill me-1"></i>@course.Credits tín chỉ
                            </span>
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-light text-dark mb-2 align-self-start">
                            <i class="bi bi-tag me-1"></i>@course.Category?.Name
                        </span>
                        <h5 class="card-title fw-bold">@course.Name</h5>
                        <p class="card-text text-muted mb-2">
                            <i class="bi bi-person-badge me-1"></i>@course.Lecturer
                        </p>
                        <p class="card-text small text-muted mb-3">
                            <i class="bi bi-calendar-check me-1"></i>
                            Đăng ký: @enrollment.EnrollDate.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <form asp-controller="Enrollment" asp-action="Unenroll" method="post" class="mt-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@course.Id" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("MyCourses", "Enrollment")" />
                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm w-100"
                                    onclick="return confirm('Bạn có chắc muốn hủy đăng ký học phần này?')">
                                <i class="bi bi-x-circle me-1"></i>Hủy đăng ký
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
